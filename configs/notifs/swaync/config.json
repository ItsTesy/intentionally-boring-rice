{
	"$schema": "/etc/xdg/swaync/configSchema.json",
	"positionX": "right",
	"positionY": "top",
	"control-center-positionX": "right",
	"control-center-positionY": "top",
	"layer": "overlay",
	"control-center-layer": "top",
	"layer-shell": true,
	"cssPriority": "user",
	"control-center-exclusive-zone": false,
	"control-center-width": 320,
	"control-center-height": 320,
	"fit-to-screen": false,
	"notification-window-width": 320,
	"transition-time": 0,
	"timeout": 6,
	"timeout-low": 4,
	"timeout-critical": 0,
	"image-visibility": "never",
	"notification-grouping": false,
	"notification-inline-replies": false,
	"notification-2fa-action": false,
	"relative-timestamps": false,
	"keyboard-shortcuts": true,
	"hide-on-clear": true,
	"hide-on-action": true,
	"script-fail-notify": false,
	"text-empty": "",
	"widgets": ["notifications"]
}
