font=JetBrainsMono Nerd Font 9
background-color=#101010
text-color=#b8b8b8
border-color=#2a2a2a
border-size=1
border-radius=0
width=320
height=80
padding=10,12
margin=4
outer-margin=8
anchor=top-right
max-visible=3
icons=0
markup=0
format=%s\n%b
default-timeout=6000
progress-color=over #2a2a2a

on-button-left=dismiss
on-button-right=dismiss-all

[urgency=low]
text-color=#6a6a6a
default-timeout=4000

[urgency=critical]
text-color=#a04040
border-color=#a04040
default-timeout=0
