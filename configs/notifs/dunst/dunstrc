[global]
	monitor = 0
	follow = none
	width = 320
	height = (0, 80)
	origin = top-right
	offset = (8, 30)
	notification_limit = 3

	progress_bar = false
	indicate_hidden = no
	transparency = 0
	separator_height = 1
	padding = 10
	horizontal_padding = 12
	frame_width = 1
	frame_color = "#2a2a2a"
	separator_color = frame
	corner_radius = 0
	gap_size = 4

	font = JetBrainsMono Nerd Font 9
	line_height = 0
	markup = no
	format = "%s\n%b"
	alignment = left
	word_wrap = yes
	ellipsize = end

	# no icons
	enable_recursive_icon_lookup = false
	min_icon_size = 0
	max_icon_size = 0

	mouse_left_click = close_current
	mouse_right_click = close_all

[urgency_low]
	background = "#101010"
	foreground = "#6a6a6a"
	timeout = 4

[urgency_normal]
	background = "#101010"
	foreground = "#b8b8b8"
	timeout = 6

[urgency_critical]
	background = "#101010"
	foreground = "#a04040"
	frame_color = "#a04040"
	timeout = 0
