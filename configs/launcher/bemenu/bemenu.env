BEMENU_OPTS="-i -l 0 -p '>' -B 1 --fn 'JetBrainsMono Nerd Font 10'"

# unset fields render pink
BEMENU_OPTS="$BEMENU_OPTS --tb #101010 --tf #6a6a6a --fb #101010 --ff #b8b8b8 --cb #b8b8b8 --cf #101010"
BEMENU_OPTS="$BEMENU_OPTS --nb #101010 --nf #6a6a6a --hb #4a4a4a --hf #b8b8b8 --sb #101010 --sf #b8b8b8"
BEMENU_OPTS="$BEMENU_OPTS --ab #101010 --af #6a6a6a --fbb #101010 --fbf #6a6a6a --scb #101010 --scf #4a4a4a"
BEMENU_OPTS="$BEMENU_OPTS --bdr #2a2a2a"

export BEMENU_OPTS
